{
  "name": "ai-usage",
  "version": "1.0.64",
  "private": true,
  "license": "MIT",
  "description": "Local-first Windows dashboard for Codex, Claude, and Fable subscription allowances, run-out forecasts, and API-equivalent cost.",
  "main": "electron/main.cjs",
  "type": "module",
  "updateFeed": {
    "provider": "github",
    "owner": "DanDG923",
    "repo": "ai-usage",
    "private": false
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "tsc -b && vite build",
    "build": "npm run test && npm run installer:check && npm run build:web && npm run release:notes && electron-builder --config tools/electron-builder.cjs --win portable nsis --x64 --publish never && npm run release:audit",
    "release:audit": "node tools/audit-release.cjs",
    "release:notes": "node tools/release-notes.cjs",
    "pack": "npm run build:web && electron-builder --config tools/electron-builder.cjs --dir --publish never",
    "test": "node --require ./tests/setup.cjs --test --test-concurrency=2 tests/*/*.test.cjs",
    "test:mod": "cd claude-code-mod && claude plugin validate . && claude plugin test",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 127.0.0.1",
    "test:electron": "node tools/test-electron.cjs",
    "version:check": "node tools/bump-version.cjs --check",
    "installer:check": "node tools/claude-installer-pin.cjs --check",
    "installer:update": "node tools/claude-installer-pin.cjs --update"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.314",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "45.2.0",
    "electron-builder": "26.18.0",
    "js-yaml": "5.5.0",
    "lucide-react": "1.70.0",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "wait-on": "9.5.1"
  },
  "overrides": {
    "glob@>=9.0.0 <14.0.2": "^14.0.4",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5"
  },
  "build": {
    "appId": "com.local.aiusage",
    "productName": "AI Usage",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!**/*.map",
      "electron/**/*",
      "claude-code-mod/.claude-plugin/plugin.json",
      "claude-code-mod/hooks/*.json",
      "claude-code-mod/hooks/*.js",
      "build/icon.png",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-win32-*/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk/bridge.mjs",
      "!node_modules/@anthropic-ai/claude-agent-sdk/browser-sdk.js",
      "!dist/assets/demo-*.js",
      "!dist/assets/flyout-preview-*.js"
    ],
    "directories": {
      "output": "release"
    },
    "releaseInfo": {
      "releaseNotesFile": "release/release-notes.md"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "AI-Usage-Portable-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "AI-Usage-Setup-${version}-${arch}.${ext}",
      "include": "build/installer.nsh",
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "DanDG923",
      "repo": "ai-usage",
      "private": false
    }
  }
}
