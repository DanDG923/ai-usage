{
  "name": "ai-usage",
  "version": "1.0.49",
  "private": true,
  "description": "Local-first AI subscription usage, runway forecasting, and API-equivalent cost dashboard.",
  "main": "electron/main.cjs",
  "type": "module",
  "updateFeed": {
    "provider": "github",
    "owner": "DanDG923",
    "repo": "ai-usage",
    "private": true
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "tsc -b && vite build",
    "build": "npm run test && npm run build:web && npm run release:notes && electron-builder --config tools/electron-builder.cjs --win portable nsis --x64 --publish never && npm run release:audit",
    "release:audit": "node tools/audit-release.cjs",
    "release:notes": "node tools/release-notes.cjs",
    "pack": "npm run build:web && electron-builder --config tools/electron-builder.cjs --dir --publish never",
    "test": "node --require ./tests/setup.cjs --test --test-concurrency=2 tests/*.test.cjs",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 127.0.0.1",
    "test:electron": "node tools/test-electron.cjs",
    "version:check": "node tools/bump-version.cjs --check"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.270",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "js-yaml": "5.4.2",
    "lucide-react": "1.45.0",
    "oxlint": "1.82.0",
    "prettier": "3.9.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.local.aiusage",
    "productName": "AI Usage",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!**/*.map",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-win32-*/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk/bridge.mjs",
      "!node_modules/@anthropic-ai/claude-agent-sdk/browser-sdk.js",
      "!dist/assets/demo-*.js"
    ],
    "directories": {
      "output": "release"
    },
    "releaseInfo": {
      "releaseNotesFile": "release/release-notes.md"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "AI-Usage-Portable-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "AI-Usage-Setup-${version}-${arch}.${ext}",
      "include": "build/installer.nsh",
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "DanDG923",
      "repo": "ai-usage",
      "private": true
    }
  }
}
